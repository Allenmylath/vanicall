# Neither image needs these, and they dominate the build context: it is uploaded to the Fly builder
# on every deploy, so leaving them in cost ~1.8 GB and 39k files per build. They are gitignored,
# but .dockerignore does not inherit from .gitignore — it has to be said again here.
frontend
transcript-backend
samplefrontend
**/node_modules

target
.git
.gitignore
.env
.dockerignore
Dockerfile
fly.toml
README.md
**/*.md

# The Node projects share this build context with the Rust image. Exclude only their build output
# and dependencies — the sources themselves must stay, because the ingest-worker image builds
# ingest-lib from source and both are built with the repo root as context.
ingest-lib/node_modules
ingest-lib/dist
ingest-lib/*.tgz
ingest-worker/node_modules
