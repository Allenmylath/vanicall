{
  "name": "@vanicall/ingest",
  "version": "0.1.0",
  "description": "Create vanicall rooms and push external video into them over WHIP.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "vanicall",
    "whip",
    "webrtc",
    "ingest",
    "rtsp",
    "ffmpeg"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5.6"
  }
}
